{
  "name": "novachat",
  "version": "3.0.1",
  "description": "NovaChat \u2013 KI-Chat mit Dokumenten, offline und online. Desktop (Electron) und Android (Capacitor).",
  "main": "electron/main.js",
  "author": "NovaChat",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "serve": "node scripts/serve.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "android:add": "cap add android && node scripts/patch-android.js",
    "android:sync": "cap sync android",
    "android:icons": "capacitor-assets generate --android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:build": "npm run android:add && npm run android:icons && cap sync android && cd android && ./gradlew assembleDebug",
    "postinstall": "node scripts/copy-vendor.js",
    "model:bundle": "node scripts/bundle-model.js"
  },
  "build": {
    "appId": "de.novachat.app",
    "productName": "NovaChat",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NovaChat-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "resources/icon.png",
      "artifactName": "NovaChat.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "artifactName": "NovaChat-Mac.${ext}"
    },
    "asarUnpack": [
      "www/models/**"
    ]
  },
  "devDependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@wllama/wllama": "^3.6.1",
    "docx": "^9.7.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1"
  }
}
